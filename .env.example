# --- Database (Railway PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Auth ---
AUTH_SECRET="generate-64-char-random-hex: openssl rand -hex 32"

# --- Cloudflare R2 (S3-compatible, free tier) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="lms-audio"

# --- Google Cloud / YouTube Data API v3 (teacher channel OAuth) ---
GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"

# --- Public URL of the deployment (used for OAuth redirect) ---
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# --- Runtime ---
PORT=3000
NODE_ENV=production

# ── Lesson recording (Teaching Studio + recording-service) ──
RECORDING_SERVICE_URL="https://recording-service-xxxx.up.railway.app"
NEXT_PUBLIC_RECORDING_SERVICE_URL="https://recording-service-xxxx.up.railway.app"
RECORDING_SHARED_SECRET="32-char-random-shared-with-the-service"
