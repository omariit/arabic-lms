// Arabic-first single-teacher LMS — complete Prisma schema (PostgreSQL, Railway-optimized)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users, Sessions & Security ----------

enum Role {
  ADMIN // platform owner
  TEACHER // the single Quran teacher
  STUDENT
  ASSISTANT // teaching assistant: follows student chats when the teacher is unavailable
}

enum ViolationType {
  WATERMARK_TAMPER
  TAB_SWITCH_DURING_EXAM
  DEVICE_MISMATCH
  RATE_LIMIT_ABUSE
  OTHER
}

model User {
  id           String        @id @default(cuid())
  fullName     String
  phone        String        @unique // normalized E.164 (+9627...); used for login + watermark identity
  countryCode  String        @default("JO") // ISO 3166 alpha-2; drives pricing + currency display
  passwordHash String
  role         Role          @default(STUDENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions           Session[]
  enrollments        Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  voucherRedemptions Voucher[]
  examAttempts       ExamAttempt[]
  audioSubmissions   AudioSubmission[]
  violations         SecurityViolation[]
  attendanceLogs     AttendanceLog[]
  conversations      Conversation[]
  pushSubscriptions  PushSubscription[]
  lessonThreads      LessonThread[]

  @@index([role])
}

// ---------- Site content (landing page CMS) ----------

// Singleton row (id = "landing") holding section visibility + editable texts for AR/EN.
model SiteContent {
  id        String   @id @default("landing")
  data      Json     // { sections: {key: bool}, texts: { ar: {key: string|list}, en: {...} } }
  updatedAt DateTime @updatedAt
}

// ---------- Push notifications (PWA) ----------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // browser push endpoint URL
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Student ↔ staff chat ----------

model Conversation {
  id            String   @id @default(cuid())
  studentId     String
  subject       String   @default("") // e.g. course title or general inquiry
  lastMessageAt DateTime @default(now())
  staffUnread   Int      @default(0) // messages from student not yet read by staff
  studentUnread Int      @default(0) // messages from staff not yet read by student
  assignedToId  String?  // staff member currently handling this conversation
  createdAt     DateTime @default(now())

  student  User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([studentId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String   @db.Text
  audioKey       String? // voice note (private R2 object, browser → R2 direct)
  audioMime      String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  deviceFingerprint String // SHA-256 of UA + IP + platform hints
  ipAddress         String
  userAgent         String
  active            Boolean  @default(true) // single-device enforcement
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, active])
  @@index([deviceFingerprint])
}

model SecurityViolation {
  id        String        @id @default(cuid())
  userId    String?
  type      ViolationType
  detail    String // JSON payload: examId, sessionId, raw event
  ipAddress String?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ---------- Single-teacher identity & YouTube OAuth ----------

model TeacherProfile {
  id           String   @id @default(cuid())
  displayName  String
  title        String   @default("المعلمة") // e.g. "معلمة الرياضيات"
  bio          String   @db.Text
  methodology  String   @db.Text // teaching methodology
  achievements String   @db.Text // newline-separated achievements
  photoUrl     String?
  cliqAlias    String? // CliQ/bank transfer alias for enrollment receipts
  bankHint     String?
  whatsappNumber String? // normalized wa.me digits (no +/00) for the public "تواصل مع الإدارة" button
  updatedAt    DateTime @updatedAt
}

model TeacherOAuthToken {
  id           String   @id @default(cuid())
  channelId    String // YouTube channel id (unique per teacher = single row)
  refreshToken String // stored server-side only, never sent to clients
  scope        String
  connectedAt  DateTime @default(now())

  @@unique([channelId])
}

// ---------- Curriculum ----------

model Course {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  price       Int        @default(0) // DEFAULT monthly price; 0 = free; overridden per country via CoursePrice
  level       String     @default("عام")
  published   Boolean    @default(false)
  coverColor  String     @default("#1d5fe0")
  coverImageKey String? // uploaded cover image (private R2 object)
  outcomes    String     @db.Text @default("") // "ستتعلّمين" bullet list, one per line
  requirements String    @db.Text @default("") // prerequisites, one per line
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  modules           Module[]
  enrollments       Enrollment[]
  enrollmentRequests EnrollmentRequest[]
  exams             Exam[]
  liveSessions      LiveSession[]
  vouchers          Voucher[]
  prices            CoursePrice[]
  weeklyMeetings    String        @db.Text @default("") // multiline, e.g. "الثلاثاء 6:00 م"

  @@index([published])
}

// Per-country monthly price overrides (e.g. cheaper for Jordan, USD for USA)
model CoursePrice {
  id          String @id @default(cuid())
  courseId    String
  countryCode String // ISO 3166 alpha-2
  price       Int
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, countryCode])
  @@index([countryCode])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

enum LessonAccess {
  FREE_PREVIEW
  ENROLLED
}

model Lesson {
  id        String      @id @default(cuid())
  moduleId  String
  title     String
  access    LessonAccess @default(ENROLLED)
  youtubeId String // stored server-side; never exposed raw to clients
  duration  Int         @default(0) // seconds
  position  Int         @default(0)
  description String   @db.Text @default("") // lesson content shown under the video
  scriptText  String   @db.Text @default("") // lesson script/transcript
  assignmentTitle String?
  assignmentInstructions String @db.Text @default("") // empty = no assignment
  audioKey   String? // teacher's own recording of the lesson (private R2 object)

  module  Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  threads LessonThread[]
  resources LessonResource[]

  @@index([moduleId, position])
}

// Downloadable material attached to a lesson (PDF/mushaf image/audio), private R2 object.
model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  title     String
  fileKey   String
  mimeType  String
  size      Int      @default(0)
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ---------- Per-lesson private assignment threads (Udemy-style) ----------

// One private thread per (lesson, student). The student sees only her own
// thread; the teacher opens the lesson and sees every student's thread.
model LessonThread {
  id            String   @id @default(cuid())
  lessonId      String
  studentId     String
  staffUnread   Int      @default(0) // new student messages not yet read by staff
  studentUnread Int      @default(0) // new staff replies not yet read by student
  assignedToId  String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student  User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages LessonMessage[]

  @@unique([lessonId, studentId])
  @@index([lessonId, lastMessageAt])
}

model LessonMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  senderRole Role
  body      String   @db.Text
  audioKey  String?  // optional voice note (R2 object key)
  audioMime String?
  createdAt DateTime @default(now())

  thread LessonThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------- Enrollment & payments ----------

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  grantedVia  String           @default("manual") // manual | voucher | request
  grantedById String? // teacher id
  createdAt   DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model EnrollmentRequest {
  id         String        @id @default(cuid())
  userId     String
  courseId   String
  receiptRef String // CliQ/bank transfer reference or receipt note
  receiptKey String? // R2 key of the uploaded transfer screenshot (browser → R2 direct)
  note       String?
  status     RequestStatus @default(PENDING)
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([courseId])
}

model Voucher {
  id         String     @id @default(cuid())
  code       String     @unique
  courseId   String
  createdBy  String // teacher id
  usedById   String?
  usedAt     DateTime?
  expired    Boolean    @default(false)
  createdAt  DateTime   @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@index([courseId])
}

// ---------- Exams ----------

enum ExamType {
  MCQ // auto-graded electronic exam (MCQ + True/False)
  VOICE // voice exam, manual teacher grading
}

model Exam {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  type        ExamType @default(MCQ)
  durationMin Int      @default(15) // countdown for MCQ; max duration for VOICE
  maxGrade    Int      @default(100)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  ExamAttempt[]

  @@index([courseId, type])
}

enum QuestionType {
  MCQ
  TRUE_FALSE
}

model Question {
  id           String       @id @default(cuid())
  examId       String
  text         String       @db.Text
  type         QuestionType @default(MCQ)
  options      Json // string[] for MCQ; ["صح","خطأ"] for TRUE_FALSE
  correctIndex Int // index of the correct option
  position     Int          @default(0)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, position])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model ExamAttempt {
  id         String        @id @default(cuid())
  userId     String
  examId     String
  status     AttemptStatus @default(IN_PROGRESS)
  answers    Json? // questionId -> selected index (MCQ)
  autoScore  Int? // auto-graded score (MCQ)
  manualGrade Int? // teacher grade (VOICE + override)
  feedbackText String? // teacher text notes
  feedbackAudioKey String? // teacher voice feedback (R2 object key)
  startedAt  DateTime      @default(now())
  submittedAt DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  audioFiles    AudioSubmission[]

  @@unique([userId, examId])
  @@index([status])
}

model AudioSubmission {
  id        String   @id @default(cuid())
  attemptId String
  userId    String
  examId    String
  audioKey  String // R2 object key
  mimeType  String
  createdAt DateTime @default(now())

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([userId])
}

// ---------- Live sessions ----------

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

/// CLASSROOM = YouTube live broadcast + audio room (existing flow)
/// MEETING   = fully in-house video meeting (SFU-less WebRTC mesh, no YouTube needed)
enum RoomMode {
  CLASSROOM
  MEETING
}

model LiveSession {
  id            String     @id @default(cuid())
  courseId      String
  title         String
  scheduledAt   DateTime?
  youtubeVideoId String? // captured automatically by the one-click launcher
  mode          RoomMode   @default(CLASSROOM)
  status        LiveStatus @default(SCHEDULED)
  inviteToken   String?    @unique // public invite link token for non-registered guests
  guestAllowed  Boolean    @default(true)
  maxSeats      Int        @default(12) // mesh capacity guard (client CPU bound)
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime   @default(now())

  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  chatMessages   LiveMessage[]

  @@index([courseId, status])
}

/// In-meeting chat (text and voice notes), visible to the room only.
model LiveMessage {
  id            String   @id @default(cuid())
  liveSessionId String
  authorName    String
  authorRole    Role? // null = invited guest
  body          String   @db.Text @default("")
  audioKey      String?
  audioMime     String?
  createdAt     DateTime @default(now())

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)

  @@index([liveSessionId, createdAt])
}

model AttendanceLog {
  id            String   @id @default(cuid())
  liveSessionId String
  userId        String
  joinedAt      DateTime @default(now())
  leftAt        DateTime?

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId, joinedAt])
  @@index([liveSessionId])
  @@index([userId])
}

// ---------- Public social proof (landing page) ----------

model Testimonial {
  id        String   @id @default(cuid())
  name      String // e.g. "أ. فاطمة — إجازة في حفظ" (full names hidden by default)
  text      String   @db.Text
  level     String? // المستوى / الدورة الإجازة فيها
  rating    Int      @default(5) // 1..5
  published Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([published])
}
